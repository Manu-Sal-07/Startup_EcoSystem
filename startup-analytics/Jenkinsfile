pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        REPO_URL = 'https://github.com/Manu-Sal-07/Startup_EcoSystem.git'
        REPO_BRANCH = 'main'
        WORKSPACE_DIR = "startup-analytics"
        DOCKER_REGISTRY = "docker.io"
        DOCKER_IMAGE_BACKEND = "startup-ecosystem-backend"
        DOCKER_IMAGE_FRONTEND = "startup-ecosystem-frontend"
        BACKEND_PORT = "8000"
        FRONTEND_PORT = "80"
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "═══════════════════════════════════════════════════════════"
                    echo "STAGE: Checkout"
                    echo "═══════════════════════════════════════════════════════════"
                }
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${REPO_BRANCH}"]],
                    userRemoteConfigs: [[url: "${REPO_URL}"]]
                ])
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()
                    env.GIT_COMMIT_MSG = sh(
                        script: "git log -1 --pretty=%B",
                        returnStdout: true
                    ).trim()
                    echo "✓ Repository cloned successfully"
                    echo "  Commit: ${GIT_COMMIT_SHORT}"
                    echo "  Message: ${GIT_COMMIT_MSG}"
                }
            }
        }

        stage('Workspace Audit') {
            steps {
                script {
                    echo "═══════════════════════════════════════════════════════════"
                    echo "STAGE: Workspace Audit (DEBUG)"
                    echo "═══════════════════════════════════════════════════════════"
                }
                sh '''
                    echo "=== Current Working Directory ==="
                    pwd
                    echo ""
                    echo "=== Root Directory Listing ==="
                    ls -la
                    echo ""
                    echo "=== Finding requirements.txt ==="
                    find . -name requirements.txt -type f
                    echo ""
                    echo "=== Finding Dockerfiles ==="
                    find . -name Dockerfile -type f
                    echo ""
                    echo "=== Finding docker-compose.yml ==="
                    find . -name docker-compose.yml -type f
                    echo ""
                    echo "=== Full Directory Tree ==="
                    find . -type d | sort
                    echo ""
                    echo "=== Startup Analytics Contents ==="
                    ls -la startup-analytics/ || echo "startup-analytics not found"
                    echo ""
                    echo "=== Backend Contents ==="
                    ls -la startup-analytics/backend/ || echo "startup-analytics/backend not found"
                '''
            }
        }

        stage('Backend Validation') {
            steps {
                script {
                    echo "═══════════════════════════════════════════════════════════"
                    echo "STAGE: Backend Validation"
                    echo "═══════════════════════════════════════════════════════════"
                }
                dir("${WORKSPACE_DIR}") {
                    script {
                        echo "Running backend validation..."
                        sh '''
                            echo "=== Workspace Directory ==="
                            pwd
                            echo ""
                            echo "=== Directory Listing ==="
                            ls -la
                            echo ""
                            echo "=== Verifying requirements.txt ==="
                            if [ -f requirements.txt ]; then
                              echo "✓ requirements.txt found"
                              echo ""
                              echo "=== Dependencies ==="
                              cat requirements.txt
                            else
                              echo "✗ requirements.txt not found"
                              exit 1
                            fi
                            echo ""
                            echo "=== Python Availability ==="
                            if command -v python3 &> /dev/null; then
                              python3 --version
                            elif command -v python &> /dev/null; then
                              python --version
                            else
                              echo "✗ Python not found"
                              exit 1
                            fi
                            echo ""
                            echo "=== Backend Structure ==="
                            if [ -d backend ]; then
                              echo "✓ backend directory exists"
                              ls -la backend/
                            else
                              echo "✗ backend directory not found"
                              exit 1
                            fi
                            echo ""
                            echo "=== Python Syntax Validation ==="
                            python3 -m py_compile backend/app.py 2>/dev/null || python -m py_compile backend/app.py
                            echo "✓ backend/app.py syntax valid"
                            python3 -m py_compile backend/models.py 2>/dev/null || python -m py_compile backend/models.py
                            echo "✓ backend/models.py syntax valid"
                            python3 -m py_compile backend/auth.py 2>/dev/null || python -m py_compile backend/auth.py
                            echo "✓ backend/auth.py syntax valid"
                            echo ""
                            echo "✓ Backend validation complete"
                        '''
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    echo "═══════════════════════════════════════════════════════════"
                    echo "STAGE: Docker Build"
                    echo "═══════════════════════════════════════════════════════════"
                }
                dir("${WORKSPACE_DIR}") {
                    script {
                        // Build frontend image
                        sh '''
                            echo "Building frontend Docker image..."
                            docker build -f frontend/Dockerfile -t ${DOCKER_IMAGE_FRONTEND}:${GIT_COMMIT_SHORT} .
                            docker tag ${DOCKER_IMAGE_FRONTEND}:${GIT_COMMIT_SHORT} ${DOCKER_IMAGE_FRONTEND}:latest
                            echo "✓ Frontend image built: ${DOCKER_IMAGE_FRONTEND}:${GIT_COMMIT_SHORT}"
                        '''

                        // Build backend image
                        sh '''
                            echo "Building backend Docker image..."
                            docker build -f backend/Dockerfile -t ${DOCKER_IMAGE_BACKEND}:${GIT_COMMIT_SHORT} .
                            docker tag ${DOCKER_IMAGE_BACKEND}:${GIT_COMMIT_SHORT} ${DOCKER_IMAGE_BACKEND}:latest
                            echo "✓ Backend image built: ${DOCKER_IMAGE_BACKEND}:${GIT_COMMIT_SHORT}"
                        '''

                        // Verify images exist
                        sh '''
                            echo "Verifying Docker images..."
                            docker images | grep -E "${DOCKER_IMAGE_FRONTEND}|${DOCKER_IMAGE_BACKEND}"
                            echo "✓ Both images verified"
                        '''
                    }
                }
            }
        }

        stage('Deployment') {
            steps {
                script {
                    echo "═══════════════════════════════════════════════════════════"
                    echo "STAGE: Deployment"
                    echo "═══════════════════════════════════════════════════════════"
                }
                dir("${WORKSPACE_DIR}") {
                    script {
                        // Generate environment configuration
                        sh '''
                            echo "Generating environment configuration..."
                            cat > .env <<'ENVEOF'
NEO4J_AUTH=neo4j/password123
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_URI=bolt://localhost:7687
NEO4J_URI_DOCKER=bolt://neo4j:7687
REDIS_HOST=localhost
REDIS_HOST_DOCKER=redis
REDIS_PORT=6379
NEO4J_dbms_memory_heap_initial__size=512m
NEO4J_dbms_memory_heap_max__size=1G
BACKEND_IMAGE=startup-ecosystem-backend
FRONTEND_IMAGE=startup-ecosystem-frontend
BACKEND_PORT=8000
FRONTEND_PORT=80
ENVEOF
                            echo "✓ .env generated with demo values"
                            echo ""
                            echo "=== Environment Variables ==="
                            cat .env
                            echo ""
                        '''

                        // Full Docker cleanup
                        sh '''
                            echo "=== PHASE 1: Full Docker Cleanup ==="
                            echo ""
                            echo "Step 1: Remove Docker Compose services with volumes..."
                            docker-compose down --remove-orphans --volumes 2>/dev/null || true
                            sleep 2
                            echo "✓ Docker Compose stack removed"
                            echo ""
                            echo "Step 2: Force remove stale startup containers..."
                            docker rm -f $(docker ps -aq --filter "name=startup") 2>/dev/null || true
                            echo "✓ Stale containers removed"
                            echo ""
                            echo "Step 3: Prune networks..."
                            docker network prune -f 2>/dev/null || true
                            echo "✓ Networks pruned"
                            echo ""
                            echo "Step 4: Prune volumes..."
                            docker volume prune -f 2>/dev/null || true
                            echo "✓ Volumes pruned"
                            echo ""
                            echo "Step 5: Verify cleanup..."
                            echo "Active containers:"
                            docker ps -a --filter "name=startup" --format "table {{.Names}}\t{{.State}}" || echo "  (none)"
                            echo ""
                            echo "Active networks:"
                            docker network ls --filter "name=startup" --format "table {{.Name}}\t{{.Driver}}" || echo "  (none)"
                            echo ""
                            echo "✓ Cleanup complete"
                            echo ""
                        '''

                        // Pull latest images and start services
                        sh '''
                            echo "=== PHASE 2: Prepare Services ==="
                            echo ""
                            echo "Step 1: Pull public images (neo4j, redis)..."
                            docker-compose pull neo4j redis || true
                            echo "✓ Public images pulled"
                            echo ""
                            echo "Step 2: Build local backend and frontend images with latest code..."
                            docker-compose build backend frontend
                            echo "✓ Local images built"
                            echo ""
                            echo "Step 3: Start Docker services with fresh state..."
                            docker-compose up -d --force-recreate --remove-orphans
                            echo "✓ Services brought up"
                            echo ""
                            echo "Step 4: Wait for services to stabilize (15 seconds)..."
                            sleep 15
                            echo "✓ Stabilization complete"
                            echo ""
                        '''

                        // Initial backend diagnostics
                        sh '''
                            echo "=== PHASE 2B: Backend Startup Diagnostics ==="
                            echo ""
                            echo "Container status (docker ps -a):"
                            docker ps -a --format "table {{.Names}}\t{{.Status}}\t{{.ExitCode}}"
                            echo ""
                            echo "Docker Compose services:"
                            docker-compose ps
                            echo ""
                            echo "Backend container details:"
                            docker inspect startup-analytics-backend-1 2>/dev/null | grep -E "\"State\"|\"Status\"|\"ExitCode\"" | head -10 || echo "(container not found)"
                            echo ""
                            echo "=== Backend Environment Variables ==="
                            docker exec startup-analytics-backend-1 env 2>/dev/null | grep -E "NEO4J_URI|REDIS_HOST|REDIS_PORT" || echo "(container not running or env unavailable)"
                            echo ""
                            echo "Backend logs (last 150 lines):"
                            docker logs startup-analytics-backend-1 2>&1 | tail -150 || echo "(no logs available)"
                            echo ""
                        '''

                        // Verify deployment
                        sh '''
                            echo "=== PHASE 3: Verify Deployment ==="
                            echo ""
                            echo "Docker Compose Status:"
                            docker-compose ps
                            echo ""
                            echo "All Running Containers:"
                            docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
                            echo ""
                        '''

                        // Check service health and collect logs if needed
                        sh '''
                            echo "=== PHASE 4: Service Health Check ==="
                            echo ""
                            
                            # Check backend
                            echo "Checking backend container..."
                            if docker-compose ps backend | grep -q "Up"; then
                              echo "✓ Backend container is running"
                            else
                              echo "✗ Backend container failed to start"
                              echo ""
                              echo "=== Backend Logs ==="
                              docker-compose logs backend || true
                              echo ""
                            fi
                            
                            # Check frontend
                            echo "Checking frontend container..."
                            if docker-compose ps frontend | grep -q "Up"; then
                              echo "✓ Frontend container is running"
                            else
                              echo "✗ Frontend container failed to start"
                              echo ""
                              echo "=== Frontend Logs ==="
                              docker-compose logs frontend || true
                              echo ""
                            fi
                            
                            # Check neo4j
                            echo "Checking Neo4j container..."
                            if docker-compose ps neo4j | grep -q "Up"; then
                              echo "✓ Neo4j container is running"
                            else
                              echo "✗ Neo4j container failed to start"
                              echo ""
                              echo "=== Neo4j Logs ==="
                              docker-compose logs neo4j || true
                              echo ""
                            fi
                            
                            # Check redis
                            echo "Checking Redis container..."
                            if docker-compose ps redis | grep -q "Up"; then
                              echo "✓ Redis container is running"
                            else
                              echo "✗ Redis container failed to start"
                              echo ""
                              echo "=== Redis Logs ==="
                              docker-compose logs redis || true
                              echo ""
                            fi
                            
                            echo "✓ Health check complete"
                            echo ""
                        '''
                    }
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    echo "═══════════════════════════════════════════════════════════"
                    echo "STAGE: Health Check"
                    echo "═══════════════════════════════════════════════════════════"
                }
                dir("${WORKSPACE_DIR}") {
                    script {
                        // Check backend health
                        sh '''
                            echo "Checking backend health endpoint..."
                            for i in {1..30}; do
                              if curl -sf http://localhost:8000/health >/dev/null 2>&1; then
                                echo "✓ Backend health check passed"
                                break
                              fi
                              if [ $i -eq 30 ]; then
                                echo "✗ Backend health check failed after 30 attempts"
                                exit 1
                              fi
                              sleep 2
                            done
                        '''

                        // Check frontend health
                        sh '''
                            echo "Checking frontend HTTP response..."
                            for i in {1..30}; do
                              if curl -sf http://localhost:80 >/dev/null 2>&1; then
                                echo "✓ Frontend is responding"
                                break
                              fi
                              if [ $i -eq 30 ]; then
                                echo "✗ Frontend health check failed after 30 attempts"
                                exit 1
                              fi
                              sleep 2
                            done
                        '''

                        // Verify Neo4j
                        sh '''
                            echo "Verifying Neo4j availability..."
                            if docker exec neo4j cypher-shell -u neo4j -p password123 'RETURN 1;' >/dev/null 2>&1; then
                              echo "✓ Neo4j is available"
                            else
                              echo "✗ Neo4j health check failed"
                              exit 1
                            fi
                        '''

                        // Verify Redis
                        sh '''
                            echo "Verifying Redis availability..."
                            if docker exec redis redis-cli ping >/dev/null 2>&1; then
                              echo "✓ Redis is available"
                            else
                              echo "✗ Redis health check failed"
                              exit 1
                            fi
                        '''

                        // Final status
                        sh '''
                            echo ""
                            echo "All services health check summary:"
                            docker-compose ps
                        '''
                    }
                }
            }
        }

        stage('Success Summary') {
            steps {
                script {
                    echo "═══════════════════════════════════════════════════════════"
                    echo "STAGE: Success Summary"
                    echo "═══════════════════════════════════════════════════════════"
                    echo ""
                    echo "BUILD INFORMATION"
                    echo "  Build Number:    #${BUILD_NUMBER}"
                    echo "  Build Status:    ✓ SUCCESS"
                    echo "  Build URL:       ${BUILD_URL}"
                    echo ""
                    echo "GIT INFORMATION"
                    echo "  Repository:      ${REPO_URL}"
                    echo "  Branch:          ${REPO_BRANCH}"
                    echo "  Commit:          ${GIT_COMMIT_SHORT}"
                    echo "  Commit Message:  ${GIT_COMMIT_MSG}"
                    echo ""
                    echo "DEPLOYMENT INFORMATION"
                    echo "  Timestamp:       ${BUILD_TIMESTAMP}"
                    echo "  Frontend Image:  ${DOCKER_IMAGE_FRONTEND}:${GIT_COMMIT_SHORT}"
                    echo "  Backend Image:   ${DOCKER_IMAGE_BACKEND}:${GIT_COMMIT_SHORT}"
                    echo ""
                    echo "ACCESS POINTS"
                    echo "  Application:     http://localhost"
                    echo "  API:             http://localhost:8000"
                    echo "  API Docs:        http://localhost:8000/docs"
                    echo "  Health Check:    http://localhost:8000/health"
                    echo "  Neo4j Browser:   http://localhost:7474"
                    echo "  Redis:           localhost:6379"
                    echo ""
                    echo "═══════════════════════════════════════════════════════════"
                }
            }
        }
    }

    post {
        failure {
            script {
                echo ""
                echo "╔═══════════════════════════════════════════════════════════╗"
                echo "║ BUILD FAILED ✗                                            ║"
                echo "╚═══════════════════════════════════════════════════════════╝"
                echo ""
                echo "Build Number: #${BUILD_NUMBER}"
                echo "Failed Stage: ${env.STAGE_NAME}"
                echo "Build URL:    ${BUILD_URL}"
                echo ""
                echo "DEBUG: Show last 50 lines of build log"
                sh 'docker-compose logs --tail=50 2>/dev/null || true'
            }
        }

        always {
            deleteDir()
        }
    }
}
