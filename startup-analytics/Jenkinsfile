pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        REPO_URL = 'https://github.com/Manu-Sal-07/Startup_EcoSystem.git'
        REPO_BRANCH = 'main'
        WORKSPACE_DIR = "startup-analytics"
        DOCKER_REGISTRY = "docker.io"
        DOCKER_IMAGE_BACKEND = "startup-ecosystem-backend"
        DOCKER_IMAGE_FRONTEND = "startup-ecosystem-frontend"
        BACKEND_PORT = "8000"
        FRONTEND_PORT = "80"
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "═══════════════════════════════════════════════════════════"
                    echo "STAGE: Checkout"
                    echo "═══════════════════════════════════════════════════════════"
                }
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${REPO_BRANCH}"]],
                    userRemoteConfigs: [[url: "${REPO_URL}"]]
                ])
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()
                    env.GIT_COMMIT_MSG = sh(
                        script: "git log -1 --pretty=%B",
                        returnStdout: true
                    ).trim()
                    echo "✓ Repository cloned successfully"
                    echo "  Commit: ${GIT_COMMIT_SHORT}"
                    echo "  Message: ${GIT_COMMIT_MSG}"
                }
            }
        }

        stage('Workspace Audit') {
            steps {
                script {
                    echo "═══════════════════════════════════════════════════════════"
                    echo "STAGE: Workspace Audit (DEBUG)"
                    echo "═══════════════════════════════════════════════════════════"
                }
                sh '''
                    echo "=== Current Working Directory ==="
                    pwd
                    echo ""
                    echo "=== Root Directory Listing ==="
                    ls -la
                    echo ""
                    echo "=== Finding requirements.txt ==="
                    find . -name requirements.txt -type f
                    echo ""
                    echo "=== Finding Dockerfiles ==="
                    find . -name Dockerfile -type f
                    echo ""
                    echo "=== Finding docker-compose.yml ==="
                    find . -name docker-compose.yml -type f
                    echo ""
                    echo "=== Full Directory Tree ==="
                    find . -type d | sort
                    echo ""
                    echo "=== Startup Analytics Contents ==="
                    ls -la startup-analytics/ || echo "startup-analytics not found"
                    echo ""
                    echo "=== Backend Contents ==="
                    ls -la startup-analytics/backend/ || echo "startup-analytics/backend not found"
                '''
            }
        }

        stage('Backend Validation') {
            steps {
                script {
                    echo "═══════════════════════════════════════════════════════════"
                    echo "STAGE: Backend Validation"
                    echo "═══════════════════════════════════════════════════════════"
                }
                dir("${WORKSPACE_DIR}") {
                    script {
                        echo "Running backend validation inside Python Docker image..."
                        sh '''
                            docker run --rm \
                              -v "${PWD}:/workspace" \
                              -w /workspace \
                              python:3.12-slim \
                              bash -lc '
                                echo "=== DEBUG: Container Diagnostics ==="
                                pwd
                                echo ""
                                echo "=== Current Directory Listing ==="
                                ls -la
                                echo ""
                                echo "=== Contents of requirements.txt ==="
                                cat requirements.txt
                                echo ""
                                echo "=== Starting Python Validation ==="
                                set -e
                                python --version
                                echo "✓ Python version confirmed"
                                echo ""
                                echo "Installing dependencies..."
                                pip install --upgrade pip --quiet
                                pip install -r requirements.txt --quiet
                                echo "✓ All dependencies installed"
                                echo ""
                                echo "Validating imports..."
                                python -c "from fastapi import FastAPI; from fastapi.middleware.cors import CORSMiddleware; from backend.db import neo4j_client, redis_client; from backend.routes import achievements_router, analytics_router, connections_router, funds_router, investors_router, startups_router; print(\"✓ All imports successful\")"
                                echo ""
                                echo "Validating app.py syntax..."
                                python -m py_compile backend/app.py
                                echo "✓ Syntax validation passed"
                                echo ""
                                echo "Validating FastAPI instantiation..."
                                python -c "import sys; from backend.app import app; print(\"✓ FastAPI app instantiates successfully\")"
                                echo ""
                                echo "✓ Backend validation complete"
                              '
                        '''
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    echo "═══════════════════════════════════════════════════════════"
                    echo "STAGE: Docker Build"
                    echo "═══════════════════════════════════════════════════════════"
                }
                dir("${WORKSPACE_DIR}") {
                    script {
                        // Build frontend image
                        sh '''
                            echo "Building frontend Docker image..."
                            docker build -f frontend/Dockerfile -t ${DOCKER_IMAGE_FRONTEND}:${GIT_COMMIT_SHORT} .
                            docker tag ${DOCKER_IMAGE_FRONTEND}:${GIT_COMMIT_SHORT} ${DOCKER_IMAGE_FRONTEND}:latest
                            echo "✓ Frontend image built: ${DOCKER_IMAGE_FRONTEND}:${GIT_COMMIT_SHORT}"
                        '''

                        // Build backend image
                        sh '''
                            echo "Building backend Docker image..."
                            docker build -f backend/Dockerfile -t ${DOCKER_IMAGE_BACKEND}:${GIT_COMMIT_SHORT} .
                            docker tag ${DOCKER_IMAGE_BACKEND}:${GIT_COMMIT_SHORT} ${DOCKER_IMAGE_BACKEND}:latest
                            echo "✓ Backend image built: ${DOCKER_IMAGE_BACKEND}:${GIT_COMMIT_SHORT}"
                        '''

                        // Verify images exist
                        sh '''
                            echo "Verifying Docker images..."
                            docker images | grep -E "${DOCKER_IMAGE_FRONTEND}|${DOCKER_IMAGE_BACKEND}"
                            echo "✓ Both images verified"
                        '''
                    }
                }
            }
        }

        stage('Deployment') {
            steps {
                script {
                    echo "═══════════════════════════════════════════════════════════"
                    echo "STAGE: Deployment"
                    echo "═══════════════════════════════════════════════════════════"
                }
                dir("${WORKSPACE_DIR}") {
                    script {
                        // Stop existing services
                        sh '''
                            echo "Stopping existing Docker services..."
                            docker-compose down --remove-orphans 2>/dev/null || true
                            sleep 3
                            echo "✓ Existing services stopped"
                        '''

                        // Start new services
                        sh '''
                            echo "Starting Docker services with new images..."
                            docker-compose up -d \
                              --force-recreate \
                              --remove-orphans
                            sleep 5
                            echo "✓ Services started"
                        '''

                        // List running containers
                        sh '''
                            echo "Currently running containers:"
                            docker ps --format "table {{.Names}}\t{{.Status}}"
                        '''
                    }
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    echo "═══════════════════════════════════════════════════════════"
                    echo "STAGE: Health Check"
                    echo "═══════════════════════════════════════════════════════════"
                }
                dir("${WORKSPACE_DIR}") {
                    script {
                        // Check backend health
                        sh '''
                            echo "Checking backend health endpoint..."
                            for i in {1..30}; do
                              if curl -sf http://localhost:8000/health >/dev/null 2>&1; then
                                echo "✓ Backend health check passed"
                                break
                              fi
                              if [ $i -eq 30 ]; then
                                echo "✗ Backend health check failed after 30 attempts"
                                exit 1
                              fi
                              sleep 2
                            done
                        '''

                        // Check frontend health
                        sh '''
                            echo "Checking frontend HTTP response..."
                            for i in {1..30}; do
                              if curl -sf http://localhost:80 >/dev/null 2>&1; then
                                echo "✓ Frontend is responding"
                                break
                              fi
                              if [ $i -eq 30 ]; then
                                echo "✗ Frontend health check failed after 30 attempts"
                                exit 1
                              fi
                              sleep 2
                            done
                        '''

                        // Verify Neo4j
                        sh '''
                            echo "Verifying Neo4j availability..."
                            if docker exec neo4j cypher-shell -u neo4j -p password123 'RETURN 1;' >/dev/null 2>&1; then
                              echo "✓ Neo4j is available"
                            else
                              echo "✗ Neo4j health check failed"
                              exit 1
                            fi
                        '''

                        // Verify Redis
                        sh '''
                            echo "Verifying Redis availability..."
                            if docker exec redis redis-cli ping >/dev/null 2>&1; then
                              echo "✓ Redis is available"
                            else
                              echo "✗ Redis health check failed"
                              exit 1
                            fi
                        '''

                        // Final status
                        sh '''
                            echo ""
                            echo "All services health check summary:"
                            docker-compose ps
                        '''
                    }
                }
            }
        }

        stage('Success Summary') {
            steps {
                script {
                    echo "═══════════════════════════════════════════════════════════"
                    echo "STAGE: Success Summary"
                    echo "═══════════════════════════════════════════════════════════"
                    echo ""
                    echo "BUILD INFORMATION"
                    echo "  Build Number:    #${BUILD_NUMBER}"
                    echo "  Build Status:    ✓ SUCCESS"
                    echo "  Build URL:       ${BUILD_URL}"
                    echo ""
                    echo "GIT INFORMATION"
                    echo "  Repository:      ${REPO_URL}"
                    echo "  Branch:          ${REPO_BRANCH}"
                    echo "  Commit:          ${GIT_COMMIT_SHORT}"
                    echo "  Commit Message:  ${GIT_COMMIT_MSG}"
                    echo ""
                    echo "DEPLOYMENT INFORMATION"
                    echo "  Timestamp:       ${BUILD_TIMESTAMP}"
                    echo "  Frontend Image:  ${DOCKER_IMAGE_FRONTEND}:${GIT_COMMIT_SHORT}"
                    echo "  Backend Image:   ${DOCKER_IMAGE_BACKEND}:${GIT_COMMIT_SHORT}"
                    echo ""
                    echo "ACCESS POINTS"
                    echo "  Application:     http://localhost"
                    echo "  API:             http://localhost:8000"
                    echo "  API Docs:        http://localhost:8000/docs"
                    echo "  Health Check:    http://localhost:8000/health"
                    echo "  Neo4j Browser:   http://localhost:7474"
                    echo "  Redis:           localhost:6379"
                    echo ""
                    echo "═══════════════════════════════════════════════════════════"
                }
            }
        }
    }

    post {
        failure {
            script {
                echo ""
                echo "╔═══════════════════════════════════════════════════════════╗"
                echo "║ BUILD FAILED ✗                                            ║"
                echo "╚═══════════════════════════════════════════════════════════╝"
                echo ""
                echo "Build Number: #${BUILD_NUMBER}"
                echo "Failed Stage: ${env.STAGE_NAME}"
                echo "Build URL:    ${BUILD_URL}"
                echo ""
                echo "DEBUG: Show last 50 lines of build log"
                sh 'docker-compose logs --tail=50 2>/dev/null || true'
            }
        }

        always {
            deleteDir()
        }
    }
}
